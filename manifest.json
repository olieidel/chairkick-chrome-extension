{
  "manifest_version": 3,
  "name": "Chairkick: Screen Recorder & Loom Export",
  "description": "Record your screen and camera with Chairkick in one click, or export your Loom and Cap videos to back them up or migrate.",
  "version": "1.1.1",
  "homepage_url": "https://chairkick.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Record or export with Chairkick",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "start-recording": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Start a new Chairkick recording"
    }
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chairkick.com/*"
  ]
}
